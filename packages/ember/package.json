{
  "name": "@docfy/ember",
  "version": "0.13.1",
  "description": "The default blueprint for Embroider v2 addons.",
  "keywords": [
    "ember-addon"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "compile": "rollup --config",
    "format": "prettier . --cache --write",
    "format:check": "prettier . --cache --check",
    "lint": "concurrently \"pnpm:lint:js\" \"pnpm:lint:hbs\" \"pnpm:lint:types\" \"pnpm:lint:format\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "glint",
    "prepack": "rollup --config"
  },
  "dependencies": {
    "@docfy/core": "workspace:^0.13.1",
    "@embroider/addon-shim": "^1.8.9",
    "@embroider/macros": "^1.18.1",
    "decorator-transforms": "^2.3.0"
  },
  "peerDependencies": {
    "ember-source": ">= 6.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@babel/runtime": "^7.28.2",
    "@ember/library-tsconfig": "^1.0.0",
    "@embroider/addon-dev": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.0.0",
    "@glint/core": "1.5.2",
    "@glint/environment-ember-loose": "1.5.2",
    "@glint/environment-ember-template-imports": "1.5.2",
    "@glint/template": "1.5.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/qunit": "^2.19.12",
    "babel-plugin-ember-template-compilation": "^3.0.0",
    "concurrently": "^9.0.1",
    "ember-source": "^6.3.0",
    "ember-template-lint": "^7.9.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.0",
    "rollup": "^4.22.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/docfy-code-block.js": "./dist/_app_/components/docfy-code-block.js",
      "./components/docfy-demo/description.js": "./dist/_app_/components/docfy-demo/description.js",
      "./components/docfy-demo/example.js": "./dist/_app_/components/docfy-demo/example.js",
      "./components/docfy-demo/index.js": "./dist/_app_/components/docfy-demo/index.js",
      "./components/docfy-demo/snippet.js": "./dist/_app_/components/docfy-demo/snippet.js",
      "./components/docfy-demo/snippets.js": "./dist/_app_/components/docfy-demo/snippets.js",
      "./components/docfy-link.js": "./dist/_app_/components/docfy-link.js",
      "./components/docfy-output.js": "./dist/_app_/components/docfy-output.js",
      "./components/docfy-previous-and-next-page.js": "./dist/_app_/components/docfy-previous-and-next-page.js",
      "./services/docfy.js": "./dist/_app_/services/docfy.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  }
}
