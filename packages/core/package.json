{
  "name": "@docfy/core",
  "version": "0.12.1",
  "private": false,
  "description": "The core components of Docfy, a documentation site builder",
  "repository": "https://github.com/josemarluedke/docfy",
  "license": "MIT",
  "author": "Josemar Luedke <josemarluedke@gmail.com>",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "compile": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --cache --write",
    "format:check": "prettier . --cache --check"
  },
  "dependencies": {
    "debug": "^4.4.1",
    "fast-glob": "^3.3.3",
    "git-repo-info": "^2.1.1",
    "github-slugger": "^2.0.0",
    "hosted-git-info": "^10.1.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-extract-frontmatter": "^3.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-normalize-headings": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "to-vfile": "^8.0.0",
    "trough": "^2.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/debug": "^4.1.12",
    "@types/hast": "^3.0.4",
    "@types/hosted-git-info": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.14",
    "@types/unist": "^3.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.18.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "remark-hbs": "^0.4.1",
    "remark-math": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  }
}
